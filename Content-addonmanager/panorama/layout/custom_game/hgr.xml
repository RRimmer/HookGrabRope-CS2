<root><styles><include src="s2r://panorama/styles/csgostyles.vcss_c"/><include src="s2r://panorama/styles/custom_game/hgr.vcss_c"/></styles>
<Panel class="screen" hittest="false"><Panel id="hgr-root" class="window hidden">
<Panel class="row"><Label class="title" text="{s:title}"/><Button id='close'><Label text='Закрыть' /></Button></Panel>
<Panel class="row"><Button id='Hook'><Label text='Hook' /></Button><Button id='Grab'><Label text='Grab' /></Button><Button id='Rope'><Label text='Rope' /></Button></Panel>
<Panel id="beam-preview" class="preview"><Panel class="segment first"/><Panel class="segment middle"/><Panel class="segment last"/></Panel><Label class="subtitle" text="{s:ability}"/>
<Panel id="hgr-color-row" class="row"><Label class="caption" text="Цвет луча"/><Button id="color"><Label text="{s:color}"/></Button></Panel>
<Panel id="hgr-distance"><Panel class='row'><Label class='caption' text='Стартовая дистанция'/><Button id='distance-down'><Label text='−' /></Button><Label class='value' text='{s:distance}'/><Button id='distance-up'><Label text='+' /></Button></Panel></Panel>
<Panel id="hgr-admin" class="column"><Button id='profile'><Label text='Сменить профиль доступа' /></Button><Button id='enabled'><Label text='Доступ: {s:enabled}'/></Button></Panel>
<Panel id='hgr-limit' class='row'><Label class='caption' text='Кол-во за раунд'/><Button id='limit-down'><Label text='−' /></Button><Label class='value' text='{s:limit}'/><Button id='limit-up'><Label text='+' /></Button></Panel><Panel id='hgr-size' class='row'><Label class='caption' text='Толщина луча'/><Button id='size-down'><Label text='−' /></Button><Label class='value' text='{s:size}'/><Button id='size-up'><Label text='+' /></Button></Panel><Panel id='hgr-length' class='row'><Label class='caption' text='Дальность'/><Button id='length-down'><Label text='−' /></Button><Label class='value' text='{s:length}'/><Button id='length-up'><Label text='+' /></Button></Panel><Panel id="hgr-physics" class="column"><Panel class='row'><Label class='caption' text='Предельная дистанция'/><Button id='max-down'><Label text='−' /></Button><Label class='value' text='{s:max}'/><Button id='max-up'><Label text='+' /></Button></Panel><Panel class='row'><Label class='caption' text='Шаг колеса'/><Button id='step-down'><Label text='−' /></Button><Label class='value' text='{s:step}'/><Button id='step-up'><Label text='+' /></Button></Panel><Panel class='row'><Label class='caption' text='Сила притяжения'/><Button id='pull-down'><Label text='−' /></Button><Label class='value' text='{s:pull}'/><Button id='pull-up'><Label text='+' /></Button></Panel><Panel class='row'><Label class='caption' text='Сила отдаления'/><Button id='push-down'><Label text='−' /></Button><Label class='value' text='{s:push}'/><Button id='push-up'><Label text='+' /></Button></Panel>
<Panel class="row"><Label class="caption" text="Разрешить приближение"/><Button id="near"><Label text="{s:near}"/></Button></Panel></Panel>
<Button id='binds'><Label text='Вывести бинды способности в чат' /></Button><Button id='all-binds'><Label text='Все бинды по разделам'/></Button></Panel></Panel></root>



